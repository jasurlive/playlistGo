# server only (vercel env / vite dev api), used by api/search.ts: YouTube Data API v3 key
YOUTUBE_API_KEY=

APP_PY_YT_KEY=

# server only, used by api/visit.ts: telegram bot that pings you about new visitors (own bot, not jasurlive.uz's)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# extra themes (linen, fjord, moss, charcoal, paper) on top of light/dark; set to false to turn them off
VITE_ENABLE_EXTRA_THEMES=true
